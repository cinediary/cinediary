# Copie para .env e preencha (o .env nunca vai para o git)

# PostgreSQL local (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cinediary
DB_USER=cinediary
DB_PASSWORD=cinediary

# Clerk — Frontend API da instância (ex.: https://<slug>.clerk.accounts.dev)
CLERK_ISSUER=
# Signing secret do endpoint de webhook no dashboard do Clerk (começa com whsec_) — OBRIGATÓRIO para subir a API
CLERK_WEBHOOK_SECRET=

# TMDB — "API Read Access Token" (v4, Bearer)
TMDB_API_TOKEN=
