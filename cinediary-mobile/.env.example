# Copie para .env.local e preencha. Variáveis EXPO_PUBLIC_* vão para o bundle do app (não coloque segredos aqui).
# Deixe localhost: em dev o app troca sozinho pelo IP do computador que roda o Metro (src/shared/config/env.ts),
# então não precisa atualizar quando o IP muda. Só mude para apontar para outro servidor (ex.: https://api…).
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxx
# Host da região do projeto no PostHog (o nosso é US). É público, pode ficar assim no .env.local.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# App ID da Meta (developers.facebook.com → seu app → Configurações → Básico). É público. Sem ele, o
# "Compartilhar nos Stories" abre a folha de compartilhar do sistema em vez do editor do Instagram.
EXPO_PUBLIC_FACEBOOK_APP_ID=
