{
  "expo": {
    "name": "CineDiary",
    "slug": "cinediary-app",
    "scheme": "cinediary",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF6F0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.cinediary.mobile",
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "ZIP do Letterboxd",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.zip-archive", "com.pkware.zip-archive"]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "icon": "./assets/app.icon"
    },
    "android": {
      "package": "app.cinediary.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#A9553A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "scheme": "content" },
            { "scheme": "file" },
            { "mimeType": "application/zip" },
            { "mimeType": "application/x-zip-compressed" }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A9553A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "@clerk/expo",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["pt", "en", "es", "fr"],
            "android": ["pt", "en", "es", "fr"]
          }
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "O CineDiary usa suas fotos para você escolher a foto do perfil.",
          "cameraPermission": "O CineDiary usa a câmera para você tirar a foto do perfil.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-share",
        {
          "ios": ["instagram-stories", "instagram"],
          "android": ["com.instagram.android"]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#A9553A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3e8cdbaa-7de5-4f6b-9f33-cbacb0e77a7c"
      }
    },
    "owner": "cinediary"
  }
}
